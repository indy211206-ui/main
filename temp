name: CS Project CI

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  python-check:
    name: Python
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: ["3.10", "3.11", "3.12"]
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}

      - name: Cache pip
        uses: actions/cache@v4
        with:
          path: ~/.cache/pip
          key: ${{ runner.os }}-pip-${{ matrix.python-version }}-${{ hashFiles('**/requirements*.txt', '**/pyproject.toml') }}
          restore-keys: |
            ${{ runner.os }}-pip-${{ matrix.python-version }}-

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          if [ -f requirements.txt ]; then pip install -r requirements.txt; fi
          if [ -f requirements-dev.txt ]; then pip install -r requirements-dev.txt; fi
          if [ -f pyproject.toml ]; then pip install .; fi

      - name: Lint Python
        run: |
          if command -v flake8 >/dev/null 2>&1; then
            flake8 . || true
          else
            echo "flake8 not installed; skipping lint"
          fi

      - name: Run Python tests
        run: |
          if command -v pytest >/dev/null 2>&1; then
            pytest -q
          else
            echo "pytest not installed; skipping tests"
          fi

      - name: Build Python package
        run: |
          if [ -f pyproject.toml ] || [ -f setup.py ]; then
            python -m pip install build
            python -m build --wheel --outdir dist || true
          else
            echo "No Python packaging config found; skipping build"
          fi

      - name: Upload Python artifacts
        uses: actions/upload-artifact@v4
        with:
          name: python-artifacts-${{ matrix.python-version }}
          path: dist/**

  cpp-check:
    name: C / C++
    runs-on: ubuntu-latest
    strategy:
      matrix:
        compiler: [gcc, clang]
        build-type: [Debug, Release]
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Install build tools
        run: |
          sudo apt-get update
          sudo apt-get install -y build-essential cmake ninja-build
          if [ "${{ matrix.compiler }}" = "clang" ]; then
            sudo apt-get install -y clang
          fi

      - name: Configure CMake
        run: |
          mkdir -p build
          if [ "${{ matrix.compiler }}" = "gcc" ]; then
            cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=${{ matrix.build-type }} -DCMAKE_C_COMPILER=gcc -DCMAKE_CXX_COMPILER=g++
          else
            cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=${{ matrix.build-type }} -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++
          fi

      - name: Build C/C++
        run: cmake --build build --config ${{ matrix.build-type }} --parallel

      - name: Run CTest if available
        run: |
          if [ -f build/CTestTestfile.cmake ]; then
            ctest --test-dir build --output-on-failure
          else
            echo "No CTest configuration found; skipping tests"
          fi

      - name: Archive build
        run: |
          mkdir -p artifacts
          tar -czf artifacts/cpp-${{ matrix.compiler }}-${{ matrix.build-type }}.tar.gz -C build .

      - name: Upload C/C++ artifacts
        uses: actions/upload-artifact@v4
        with:
          name: cpp-artifacts-${{ matrix.compiler }}-${{ matrix.build-type }}
          path: artifacts/**

  luau-check:
    name: Luau
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Luau placeholder
        run: |
          echo "Luau CI placeholder activated."
          echo "Replace this step with your actual Luau toolchain if you use one."
          echo "Example:"
          echo "  - install Luau CLI or use an official runner"
          echo "  - run luau check ."
          echo "This is intentionally non-failing so your repo can still pass CI until setup is complete."

  summary:
    name: CI Summary
    needs: [python-check, cpp-check, luau-check]
    runs-on: ubuntu-latest
    if: always()
    steps:
      - name: Final status
        run: |
          echo "All CI jobs finished."
